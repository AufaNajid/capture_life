generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  operator
}

enum EventStatus {
  active
  archived
}

enum SessionMode {
  single
  strip
  gif
  boomerang
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())

  events Event[]
}

model Event {
  id        String      @id @default(uuid())
  name      String
  eventCode String      @unique
  ownerId   String
  startDate DateTime
  endDate   DateTime
  status    EventStatus @default(active)
  createdAt DateTime    @default(now())

  owner     User       @relation(fields: [ownerId], references: [id])
  templates Template[]
  sessions  Session[]

  @@index([ownerId])
}

model Template {
  id           String   @id @default(uuid())
  eventId      String
  name         String
  imageUrl     String
  layoutConfig Json
  createdAt    DateTime @default(now())

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([eventId])
}

model Session {
  id         String      @id @default(uuid())
  eventId    String
  templateId String?
  mode       SessionMode
  createdAt  DateTime    @default(now())

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  photos   Photo[]

  @@index([eventId])
  @@index([templateId])
}

model Photo {
  id            String   @id @default(uuid())
  sessionId     String
  fileUrl       String
  order         Int
  filterApplied String?
  createdAt     DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
